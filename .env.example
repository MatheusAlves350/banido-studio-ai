# ==============================================================================
# Banido Studio AI — Configuração de Instância (.env)
# Copie este arquivo para ".env" e ajuste os caminhos conforme sua máquina.
# Se nenhuma variável for definida, o sistema usa automaticamente a pasta ./data/
# Dica: use aspas em valores com espaços (ex.: BANIDO_GROUP_NAME="Meu Canal").
# ==============================================================================

# Identidade do anfitrião (Faixa 2 isolada) e nome do grupo/canal
BANIDO_HOST_NAME="Host"
BANIDO_GROUP_NAME="Banido Studio"

# Diretórios da instância (caminhos relativos são resolvidos a partir da raiz do projeto)
# Exemplo no Windows com HD secundário + SSD para temporários:
#   BANIDO_BASE_DIR="D:/StudioData"
#   BANIDO_OBS_DIR="D:/Recordings/OBS"
#   BANIDO_TEMP_DIR="C:/Temp/BanidoStudioTemp"
BANIDO_BASE_DIR="./data"
BANIDO_OBS_DIR="./data/obs_recordings"
BANIDO_CLIPS_DIR="./data/Cortes"
BANIDO_VOICE_BANK_DIR="./data/vozes_amigos"
BANIDO_MODELS_DIR="./data/models"
# BANIDO_TEMP_DIR=

# Servidor Web (altere a porta para rodar múltiplas instâncias simultâneas)
BANIDO_HOST=127.0.0.1
BANIDO_PORT=8765
# Hosts adicionais permitidos no cabeçalho Host (separados por vírgula, opcional)
# BANIDO_ALLOWED_HOSTS=

# Whisper / Transcrição (ajuste se sua GPU tiver pouca VRAM ou para rodar em CPU)
BANIDO_WHISPER_MODEL=large-v3
BANIDO_WHISPER_DEVICE=auto
BANIDO_WHISPER_COMPUTE_TYPE=auto
BANIDO_WHISPER_LANGUAGE=pt
# Transcreve microfone e Discord separadamente quando há mic isolado (0 = mix único, mais rápido)
BANIDO_SEPARATE_TRACKS=1

# Chaves de API opcionais (também podem ser salvas pela interface Web em Configurações)
# NUNCA faça commit do arquivo .env com suas chaves preenchidas!
# GOOGLE_API_KEY=
# NVIDIA_API_KEY=
# BANIDO_AI_PROVIDER=gemini
# BANIDO_GOOGLE_MODEL=gemini-2.5-flash-lite
# BANIDO_NVIDIA_MODEL=mistralai/mistral-large-4-1t-a52b
